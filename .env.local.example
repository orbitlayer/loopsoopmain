# ---------------------------------------------------------------------------
# Loopsoop — environment variables. Copy to .env (or set in Hostinger hPanel).
# ---------------------------------------------------------------------------

# MySQL (Hostinger). Use localhost when the app runs on the same box as the DB.
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_mysql_database

# Signs the admin login session cookie — any long random string (32+ chars).
SESSION_SECRET=generate_a_long_random_secret
